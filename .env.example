# =================================================================
# OPTION A: Google Gemini Free Tier (Recommended & 100% Free)
# Get your free key at: https://aistudio.google.com/
# =================================================================
OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_FAST=gemini-3.5-flash-lite
MODEL_HEAVY=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# =================================================================
# OPTION B: OpenAI (Standard)
# =================================================================
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# MODEL_FAST=gpt-5.4-mini
# MODEL_HEAVY=gpt-5.5
# EMBEDDING_MODEL=text-embedding-3-small
# REASONING_EFFORT=medium

# ---- Web search (Optional: Tavily key, or leave empty for keyless DuckDuckGo) ----
TAVILY_API_KEY=

# ---- LangSmith observability (Optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Storage / retrieval ----
CHROMA_DIR=./chroma_db
SQLITE_PATH=./memory.sqlite
RETRIEVER_K=4